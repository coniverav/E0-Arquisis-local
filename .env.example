#Copia este archivo como .env y completa los valores privados.
POSTGRES_DB=energyshark
POSTGRES_USER=energyshark
POSTGRES_PASSWORD=XXXXXX
DATABASE_URL=postgresql+psycopg://energyshark:XXXXXX@db:5432/energyshark

#Broker asignado a King's Landing (KLD).
RABBITMQ_URL=amqps://city.KLD:PASSWORD@BROKER_HOST:BROKER_PORT/energy
RABBITMQ_QUEUE=city.KLD.q

CITY_ID=KLD
RABBITMQ_OUTBOUND_EXCHANGE=energy.x
RABBITMQ_CENTRAL_ROUTING_KEY=central

#Routing key asignada a la ciudad: city.KLD

MASTER_URL=http://master:8000/internal/events
MASTER_ERROR_URL=http://master:8000/internal/protocol/errors
MASTER_AUDIT_URL=http://master:8000/internal/audit/inbound

CONNECTOR_RETRY_SECONDS=5
HTTP_RETRY_SECONDS=2
HTTP_TIMEOUT_SECONDS=10

DOMAIN=example.me
LETSENCRYPT_EMAIL=you@example.com
