#Copia este archivo como .env y completa los valores privados.
POSTGRES_DB=energyshark
POSTGRES_USER=energyshark
POSTGRES_PASSWORD=XXXXXX
DATABASE_URL=postgresql+psycopg://energyshark:XXXXXX@db:5432/energyshark

#Broker asignado a King's Landing (KLD)
RABBITMQ_URL=amqps://city.KLD:PASSWORD@broker.iic2173.org:5671/energy

#Cola de mensajes dirigidos (E1 y E2)
RABBITMQ_QUEUE=city.KLD.q

#Identidad de la ciudad
CITY_ID=KLD

#Exchange para mensajes dirigidos
RABBITMQ_OUTBOUND_EXCHANGE=energy.x
RABBITMQ_CENTRAL_ROUTING_KEY=central

#Mercado E2
RABBITMQ_MARKET_QUEUE=market.KLD
RABBITMQ_MARKET_EXCHANGE=market

#Wallet E2: reemplazar solo en .env privado; no versionar URL ni API key reales
WALLET_BASE_URL=REEMPLAZAR_CON_URL_ENTREGADA
WALLET_API_KEY=REEMPLAZAR_CON_API_KEY_PRIVADA

#Routing keys previstas a partir de CITY_ID: city.KLD y market.offer.KLD

MASTER_URL=http://master:8000/internal/messages
MASTER_ERROR_URL=http://master:8000/internal/protocol/errors
MASTER_AUDIT_URL=http://master:8000/internal/audit/inbound
MASTER_OUTBOUND_AUDIT_URL=http://master:8000/internal/audit/outbound
MASTER_OUTBOUND_DISPATCH_URL=http://master:8000/internal/audit/outbound/dispatch

CYCLE_REPORT_WINDOW_SECONDS=300
CYCLE_SCHEDULER_POLL_SECONDS=5

OUTBOUND_POLL_SECONDS=2

CONNECTOR_RETRY_SECONDS=5
HTTP_RETRY_SECONDS=2
HTTP_TIMEOUT_SECONDS=10

DOMAIN=example.me
LETSENCRYPT_EMAIL=you@example.com

#CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

#Auth
AUTH_JWKS_URL=https://dev-rz37e3yw6i3fn2bn.us.auth0.com/.well-known/jwks.json
AUTH_AUDIENCE=https://arquisis-e1-api/
AUTH_ISSUER=https://dev-rz37e3yw6i3fn2bn.us.auth0.com/

#New Relic APM
NEW_RELIC_LICENSE_KEY=dummy
NEW_RELIC_APP_NAME=EnergyShark Backend
NEW_RELIC_MONITOR_MODE=false
NEW_RELIC_LOG=stdout
NEW_RELIC_INFRA_DISPLAY_NAME=EnergyShark EC2
