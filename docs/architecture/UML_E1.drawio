        <mxCell id="SfARhjAUhrUOJl7IDvEn-179" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e6c200;" value="«note: estilos → NFR»&lt;br&gt;&lt;b&gt;Cliente-Servidor:&lt;/b&gt; SPA → Gateway → Masters (usabilidad, separación G04).&lt;br&gt;&lt;b&gt;En Capas:&lt;/b&gt; edge / dominio / datos (mantenibilidad, RNF04).&lt;br&gt;&lt;b&gt;EDA Pub-Sub:&lt;/b&gt; Central ↔ Connector + outbox (disponibilidad AD1, escalabilidad).&lt;br&gt;&lt;b&gt;Microservicio:&lt;/b&gt; Worker de timeouts (confiabilidad AD3)." vertex="1">
          <mxGeometry height="180" width="700" x="3774.1429966517862" y="1959.8571079799108" as="geometry" />
        </mxCell>
        <mxCell id="SfARhjAUhrUOJl7IDvEn-180" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e6c200;" value="«note: supuestos»&lt;br&gt;• Postgres único motor (~12 ciclos/día; basta y da transacciones).&lt;br&gt;• Validez por received_at ≤ deadline_at (el poll no extiende la ventana).&lt;br&gt;• Retry conserva idpk y genera nuevo msgId; user_id=city.CODE siempre.&lt;br&gt;• PRICE_ABOVE_CAP es error+ack (el nack del enunciado es typo).&lt;br&gt;• Sin negotiation-report hay multa de 50000 en el siguiente budget." vertex="1">
          <mxGeometry height="180" width="560" x="4514.142996651786" y="1959.8571079799108" as="geometry" />
        </mxCell>
