# Render alongside energyshark.conf, which declares energyshark_backend.
log_format energyshark_sse 'sse $request_id $request_method $status '
                          'duration=$request_time bytes=$body_bytes_sent upstream=$upstream_status';

server {
    listen 443 ssl;
    server_name ${SSE_HOST};
    ssl_certificate ${SSE_CERT};
    ssl_certificate_key ${SSE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/sse-access.log energyshark_sse;

    location = /events/stream {
        if ($args != "") { return 400; }
        if ($request_method !~ ^(GET|OPTIONS)$) { return 405; }
        proxy_pass http://energyshark_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Last-Event-ID $http_last_event_id;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache, no-store, no-transform" always;
    }

    location / { return 404; }
}
